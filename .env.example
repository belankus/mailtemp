# Published ARM64 images. For a fork, replace the repository names.
APP_IMAGE=ghcr.io/belankus/mailtemp
MIGRATE_IMAGE=ghcr.io/belankus/mailtemp-migrate
IMAGE_TAG=latest
# Compose uses its PostgreSQL by default. Use a strong URL-safe password.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
# Set only to keep using an existing PostgreSQL database (URL-encode credentials).
# DATABASE_URL=postgresql://user:password@database-host:5432/mailtemp?schema=public
API_TOKEN=replace-with-the-same-secret-as-cloudflare-worker
NEXT_PUBLIC_DOMAIN=your-email-domain.com
BASE_STORAGE_URL=https://your-existing-r2-storage-domain.com
# Only needed for development outside Compose:
# REDIS_URL=redis://localhost:6379
